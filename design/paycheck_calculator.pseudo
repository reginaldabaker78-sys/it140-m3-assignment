# IT 140 Module Three Assignment
# Paycheck Calculator Pseudocode Template
#
# Replace every TODO prompt with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Your finished pseudocode should represent the same logic as your flowchart.
# Use clear indentation and ALLCAPS pseudocode keywords, such as GET (input),
# PUT (output), LET (assignment), IF, ELSE, and ENDIF where they fit your design.

START paycheck_calculator

    GET hours_worked 
    GET hourly_pay_rate

    IF hours_worked > 40 
    LET overtime_hours = hours_worked - 40
    LET regular_pay = 40 * hourly_pay_rate
    LET overtime_pay = overtime_hours * hourly_pay_rate * 1.5
    LET gross_pay = regular_pay + overtime_pay
    ELSE 
    LET gross_pay = hours_worked * hourly_pay_rate
    ENDIF

    PUT gross_pay

END paycheck_calculator


